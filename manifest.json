{
  "manifest_version": 3,
  "name": "Playlist Manager for YouTube",
  "version": "2.0.0",
  "description": "Search, filter, sort and reverse YouTube playlists, play them in any order, skip watched videos and see time left.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Playlist Manager",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/core.js", "src/watch.js", "src/playlist.js", "src/channel.js", "src/main.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "playlist-manager@example.local",
      "strict_min_version": "115.0"
    }
  }
}
